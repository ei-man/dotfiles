================================================================================
basic txtar with commands and two archive files
================================================================================

# Add explicit group, installs by default
write-file /root/.config/starch/state.yaml @initial-state.yaml

! run pacman -Qi cowsay # not installed

run starch add archofficial/cowsay

run pacman -Qi cowsay # installed

assert-file /root/.config/starch/state.yaml @expected-state.yaml

-- initial-state.yaml --
package_groups:
    archofficial:
        tool: pacman

-- expected-state.yaml --
package_groups:
    archofficial:
        tool: pacman
        packages:
            - cowsay

