{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "txtar",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_line"
      }
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PREC",
          "value": 4,
          "content": {
            "type": "SYMBOL",
            "name": "archive_file"
          }
        },
        {
          "type": "PREC",
          "value": 3,
          "content": {
            "type": "SYMBOL",
            "name": "comment_line"
          }
        },
        {
          "type": "PREC",
          "value": 3,
          "content": {
            "type": "SYMBOL",
            "name": "bang_line"
          }
        },
        {
          "type": "PREC",
          "value": 3,
          "content": {
            "type": "SYMBOL",
            "name": "command_line"
          }
        },
        {
          "type": "PREC",
          "value": 1,
          "content": {
            "type": "SYMBOL",
            "name": "generic_line"
          }
        },
        {
          "type": "SYMBOL",
          "name": "empty_line"
        }
      ]
    },
    "empty_line": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "comment_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "newline"
        }
      ]
    },
    "bang_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "bang",
          "content": {
            "type": "SYMBOL",
            "name": "bang"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "arguments",
              "content": {
                "type": "SYMBOL",
                "name": "argument_list"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "inline_comment",
              "content": {
                "type": "SYMBOL",
                "name": "inline_comment"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "newline"
        }
      ]
    },
    "command_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "command",
          "content": {
            "type": "SYMBOL",
            "name": "command"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "arguments",
              "content": {
                "type": "SYMBOL",
                "name": "argument_list"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "inline_comment",
              "content": {
                "type": "SYMBOL",
                "name": "inline_comment"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "newline"
        }
      ]
    },
    "generic_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "line_word"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "arguments",
              "content": {
                "type": "SYMBOL",
                "name": "argument_list"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "inline_comment",
              "content": {
                "type": "SYMBOL",
                "name": "inline_comment"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "newline"
        }
      ]
    },
    "archive_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "header",
          "content": {
            "type": "SYMBOL",
            "name": "archive_header"
          }
        },
        {
          "type": "SYMBOL",
          "name": "newline"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "body",
              "content": {
                "type": "SYMBOL",
                "name": "archive_body"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "archive_header": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "open",
          "content": {
            "type": "SYMBOL",
            "name": "archive_delim"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_header_ws"
        },
        {
          "type": "FIELD",
          "name": "filename",
          "content": {
            "type": "SYMBOL",
            "name": "archive_filename"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_header_ws"
        },
        {
          "type": "FIELD",
          "name": "close",
          "content": {
            "type": "SYMBOL",
            "name": "archive_delim"
          }
        }
      ]
    },
    "archive_body": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "archive_body_line"
      }
    },
    "comment": {
      "type": "PATTERN",
      "value": "#[^\\n]*"
    },
    "inline_comment": {
      "type": "PATTERN",
      "value": "#[^\\n]*"
    },
    "bang": {
      "type": "STRING",
      "value": "!"
    },
    "command": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "run"
            },
            {
              "type": "STRING",
              "value": "write-file"
            },
            {
              "type": "STRING",
              "value": "assert-file"
            }
          ]
        }
      }
    },
    "argument_list": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "argument"
      }
    },
    "argument": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "archive_ref"
        },
        {
          "type": "SYMBOL",
          "name": "word"
        }
      ]
    },
    "archive_ref": {
      "type": "PATTERN",
      "value": "@[^\\s\\n]+"
    },
    "word": {
      "type": "PATTERN",
      "value": "[^#\\s\\n][^\\s\\n]*"
    },
    "line_word": {
      "type": "PATTERN",
      "value": "[^#!\\s\\n-][^\\s\\n]*"
    },
    "archive_delim": {
      "type": "STRING",
      "value": "--"
    },
    "archive_filename": {
      "type": "PATTERN",
      "value": "[^\\s\\n]+"
    },
    "newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "_header_ws": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[ \\t]+"
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]+"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "archive_body_line"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}