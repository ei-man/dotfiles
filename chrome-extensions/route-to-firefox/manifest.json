{
  "manifest_version": 3,
  "name": "Route to Firefox",
  "version": "1.0.0",
  "description": "Opens YouTube, YouTube Music and Spotify links in their dedicated Firefox windows instead of Chrome.",
  "key": "",
  "permissions": [
    "tabs",
    "webNavigation",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "*://youtu.be/*",
    "*://*.youtu.be/*",
    "*://*.spotify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
