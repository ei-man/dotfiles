{
  "permissions": {
    "allow": [
      "Read(/)",
      "WebFetch(*)",
      "WebSearch",
      "Bash(go*)",
      "Bash(docker*)"
    ]
  },
  "model": "claude-opus-4-5",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "effortLevel": "high",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "remoteControlAtStartup": true
}
