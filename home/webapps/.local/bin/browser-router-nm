#!/usr/bin/env python3
"""Native-messaging host for the Chrome "Route to Firefox" extension.

Chrome speaks a length-prefixed stdio protocol: a 4-byte native-endian length
followed by that many bytes of UTF-8 JSON. Read one message, hand its URL to
browser-router, acknowledge, exit.
"""

import json
import os
import struct
import subprocess
import sys

ROUTER = os.path.expanduser("~/.local/bin/browser-router")


def read_message():
    header = sys.stdin.buffer.read(4)
    if len(header) < 4:
        return None
    (length,) = struct.unpack("@I", header)
    payload = sys.stdin.buffer.read(length)
    if len(payload) < length:
        return None
    return json.loads(payload.decode("utf-8"))


def send_message(obj):
    data = json.dumps(obj).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("@I", len(data)))
    sys.stdout.buffer.write(data)
    sys.stdout.buffer.flush()


def main():
    message = read_message()
    if not message:
        return

    url = message.get("url", "")
    # The extension is the only allowed origin, but don't hand arbitrary
    # strings to the router regardless.
    if not url.startswith(("http://", "https://")):
        send_message({"ok": False, "error": "unsupported url"})
        return

    subprocess.Popen(
        [ROUTER, url],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    send_message({"ok": True})


main()
