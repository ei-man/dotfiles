[Desktop Entry]
# Overrides /usr/share/applications/vesktop.desktop purely to change the icon.
# Vesktop ships /usr/share/icons/hicolor/scalable/apps/vesktop.svg (the pink
# Vencord "Vc" mark), which shadows a same-named icon in the user theme. Naming
# ours "discord" instead sidesteps the collision — nothing else claims it.
Name=Vesktop
Exec=/usr/bin/vesktop %U
Terminal=false
Type=Application
Icon=discord
StartupWMClass=vesktop
GenericName=Internet Messenger
Categories=Network;
Keywords=discord;vencord;electron;chat;
Comment=Vesktop is a custom Discord App aiming to give you better performance and improve linux support. Vencord comes pre-installed
MimeType=x-scheme-handler/discord
