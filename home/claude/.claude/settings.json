{
  "permissions": {
    "allow": [
      "Read(/)",
      "WebFetch(*)",
      "WebSearch",
      "Bash(go*)",
      "Bash(docker*)"
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "effortLevel": "high",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "vim",
  "remoteControlAtStartup": true
}
