[Unit]
Description=Chrome CDP proxy - one approved debug connection, reused by every tool
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/chrome-cdp-proxy
# Chrome may not be up yet at login, and the connection dies whenever Chrome
# restarts; the daemon retries with backoff, so just keep it alive.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
