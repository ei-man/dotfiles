[Unit]
Description=SIRI Aarhus earlier-appointment watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/eimas/Projects/siri-watcher
ExecStart=/usr/bin/python3 /home/eimas/Projects/siri-watcher/watch.py
Restart=always
RestartSec=120

[Install]
WantedBy=default.target
