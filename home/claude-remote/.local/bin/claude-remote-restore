#!/usr/bin/env python3
"""Bring back every Claude Remote Control session that is not archived.

The server is the record. A session the app still lists (not archived) that no host is
serving is one this machine owes, whatever took it down: a reboot, a crash, a network
outage, or a host that shed its sessions and carried on. Archiving a session in the app
is how it is closed on purpose, and that is the only thing that stops it coming back.
Sessions that never ran a turn (the empty one a fresh host opens) are left alone.

Every live session here also runs in bypassPermissions. A session keeps the mode the app's
picker had when it was created, whatever the host was started with, so one sitting in auto
or default is switched the way the picker does it. plan and acceptEdits are left alone:
those are picked on purpose.

Run with no arguments at login (Hyprland exec-once) and every 2 minutes from a systemd
timer; one run at a time. `--dry-run` prints the plan and changes nothing.

How a session comes back. The server allows one `claude remote-control` host per folder
per device (409 "This folder is already served by a terminal"), a host serves a single
environment, and a session can only be reconnected to the environment it belongs to (400
otherwise; there is no moving one). So per folder:
  * no host running: point the folder's bridge-pointer.json at the environment most of its
    sessions belong to, start a host (a tab in one kitty window), and once it serves that
    environment ask the server to reconnect each session to it. The host revives the
    environment under the same id even after the server has deleted it for being offline.
  * a host already on that environment: just reconnect the sessions.
  * a host on another environment that serves nothing: replace it (stop it, release its
    folder claim) and start over as above. One that serves live sessions is left alone, and
    the sessions wait.
The main host in ~/Projects is always kept running, so the app can start new sessions.
If the server will not even list the sessions (most likely an access token that expired
while the machine was off: only a running Claude Code refreshes it), that host is started
anyway on the environment its pointer already names; it refreshes the token, and the next
run reconnects the rest.

State, in ~/.local/state/claude-remote-restore/:
  envs.json      {environment id: folder} for every environment a host here has served.
                 The server deletes an environment hours after its machine goes offline,
                 and its folder with it, so this is the one thing we have to remember.
  attempts.json  backoff for a set of sessions or hosts that will not come back: 2 min
                 doubling to 5, reset by a new boot or a different set; notifies on the
                 first failure.
  restore.log    everything we print, plus whatever a host prints on stderr (why it would
                 not start, or why it died). A host's tab closes as soon as it exits.
"""
import fcntl
import glob
import json
import os
import shlex
import signal
import socket
import subprocess
import sys
import time
import uuid
import urllib.error
import urllib.request

HOME = os.path.expanduser("~")
HOST_DIR = f"{HOME}/Projects"
PERMISSION_MODE = "bypassPermissions"
SWITCH_FROM = ("auto", "default")  # modes a session gets from the app's picker by default
PROJECTS = f"{HOME}/.claude/projects"
CREDENTIALS = f"{HOME}/.claude/.credentials.json"
STATE = f"{HOME}/.local/state/claude-remote-restore"
ENVS = f"{STATE}/envs.json"
ATTEMPTS = f"{STATE}/attempts.json"
LOG = f"{STATE}/restore.log"
LOG_MAX = 1 << 20
RETRY_FIRST_S = 120
RETRY_MAX_S = 5 * 60
HOST_WAIT_S = 120     # for a host we started to come up on its environment
SETTLE_S = 120        # for reconnected sessions to show as connected
API = "https://api.anthropic.com"
BETAS = "oauth-2025-04-20,environments-2025-11-01"


def log(*a):
    line = " ".join(str(x) for x in a)
    print("[claude-remote-restore]", line, flush=True)
    try:
        os.makedirs(STATE, exist_ok=True)
        if os.path.exists(LOG) and os.path.getsize(LOG) > LOG_MAX:
            os.replace(LOG, LOG + ".1")
        with open(LOG, "a") as f:
            f.write(time.strftime("%F %T ") + line + "\n")
    except OSError:
        pass


def boot_id():
    with open("/proc/sys/kernel/random/boot_id") as f:
        return f.read().strip()


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, path)


# ---------- this machine ----------

def project_key(cwd):
    return cwd.replace("/", "-").replace(".", "-")


def pointer_path(cwd):
    return f"{PROJECTS}/{project_key(cwd)}/bridge-pointer.json"


def read_pointer(cwd):
    return read_json(pointer_path(cwd)) or {}


def write_pointer(cwd, env, session):
    path = pointer_path(cwd)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        json.dump({"sessionId": session_id(session), "environmentId": env,
                   "source": "standalone"}, f)


def running_hosts():
    """{folder: pid} for every `claude remote-control` host, bar --session-id terminals."""
    hosts = {}
    for path in glob.glob("/proc/[0-9]*/cmdline"):
        pid = path.split("/")[2]
        try:
            with open(path, "rb") as f:
                argv = f.read().split(b"\0")
        except OSError:
            continue
        if b"remote-control" not in argv or not argv[0].endswith(b"claude"):
            continue
        if b"--session-id" in argv:
            continue
        try:
            hosts[os.readlink(f"/proc/{pid}/cwd")] = int(pid)
        except (OSError, ValueError):
            continue
    return hosts


def served_env(cwd):
    """The environment the host in `cwd` serves, or None if no host runs there."""
    if cwd not in running_hosts():
        return None
    return read_pointer(cwd).get("environmentId")


def remember_envs():
    """Record the environment every running host serves; returns the whole map."""
    envs = read_json(ENVS) or {}
    changed = False
    for cwd in running_hosts():
        env = read_pointer(cwd).get("environmentId")
        if env and envs.get(env) != cwd:
            envs[env] = cwd
            changed = True
    if changed:
        write_json(ENVS, envs)
    return envs


def stop_host(cwd, pid):
    """Stop a host, and the `fish -C claude remote-control` shell holding its tab open."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            ppid = int(f.read().rsplit(")", 1)[1].split()[1])
        with open(f"/proc/{ppid}/cmdline", "rb") as f:
            parent = f.read()
    except (OSError, ValueError, IndexError):
        ppid, parent = None, b""
    for p in [pid] + ([ppid] if b"remote-control" in parent else []):
        try:
            os.kill(p, signal.SIGTERM)
        except OSError:
            pass
    for _ in range(20):
        if running_hosts().get(cwd) != pid:
            return True
        time.sleep(0.5)
    try:
        os.kill(pid, signal.SIGKILL)
    except OSError:
        pass
    time.sleep(1)
    return running_hosts().get(cwd) != pid


def lock():
    """One run at a time: two hosts starting in one folder means a 409 for one of them."""
    os.makedirs(STATE, exist_ok=True)
    f = open(f"{STATE}/restore.lock", "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        f.close()
        return None
    return f


def launch_kitty(argv):
    """Open the hosts' kitty window so that it outlives us.

    From the systemd timer, a plain child lands in the oneshot service's cgroup, and systemd
    kills that cgroup the moment we exit — taking kitty, the host and every session it just
    adopted down with it. So there, have Hyprland start it (its own process tree, and the
    window still goes to workspace 3), or failing that make it a transient unit of its own.
    From exec-once it stays a plain child (no setsid) so the [workspace N silent] prefix can
    follow the pid chain from exec-once to the window."""
    if os.environ.get("INVOCATION_ID"):
        if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            r = subprocess.run(["hyprctl", "dispatch", "exec",
                                "[workspace 3 silent] " + shlex.join(argv)],
                               capture_output=True, text=True)
            if r.returncode == 0 and r.stdout.strip() == "ok":
                return
            log(f"hyprctl could not start kitty ({(r.stdout + r.stderr).strip()}); using systemd-run")
        subprocess.run(["systemd-run", "--user", "--collect", "--quiet", "--", *argv],
                       stdin=subprocess.DEVNULL, check=False)
        return
    subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL)


def notify(title, body, critical=False):
    subprocess.run(["notify-send", *(["-u", "critical"] if critical else []),
                    "-a", "claude-remote-restore", title, body], check=False)


# ---------- the server ----------

def api(method, path, body=None):
    """Call the bridge API as ourselves. Returns (status, data) or (None, reason)."""
    try:
        with open(CREDENTIALS) as f:
            token = json.load(f)["claudeAiOauth"]["accessToken"]
    except (OSError, ValueError, KeyError) as e:
        return None, f"no credentials ({e})"
    req = urllib.request.Request(
        API + path, method=method,
        data=json.dumps(body).encode() if body is not None else None,
        headers={"Authorization": f"Bearer {token}", "anthropic-version": "2023-06-01",
                 "anthropic-beta": BETAS, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.status, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode(errors="replace")[:200]
    except Exception as e:  # offline, DNS, timeout
        return None, str(e)[:200]


def session_id(cse_id):
    """cse_X -> session_X, the form bridge-pointer.json uses."""
    return "session_" + cse_id.split("_", 1)[1]


def all_sessions():
    """Every session the account has, or None if the server cannot be asked."""
    rows, cursor = [], None
    for _ in range(50):
        status, data = api("GET", "/v1/code/sessions?limit=100"
                           + (f"&cursor={cursor}" if cursor else ""))
        if status != 200 or not isinstance(data, dict):
            log(f"cannot list sessions: {status} {data}")
            return None
        rows += data.get("data") or []
        cursor = data.get("next_cursor")
        if not cursor or not data.get("data"):
            return rows
    return rows


def ran_a_turn(row):
    return bool((row.get("external_metadata") or {}).get("usage"))


def title(row):
    return (row.get("title") or row["id"])[:48]


def env_folder(env, envs):
    """The folder this machine served `env` from, or None if it is not one of ours."""
    if env in envs:
        return envs[env]
    status, data = api("GET", f"/v1/environments/{env}")
    if status == 200 and isinstance(data, dict):
        config = data.get("config") or {}
        if config.get("machine_name") == socket.gethostname() and config.get("directory"):
            envs[env] = config["directory"]
            write_json(ENVS, envs)
            return envs[env]
    return None


def reconnect(env, row):
    status, data = api("POST", f"/v1/environments/{env}/bridge/reconnect", {"session_id": row["id"]})
    if status == 200:
        return True
    log(f"reconnect {title(row)} failed: {status} {data}")
    return False


def set_mode(row):
    """Switch a live session's permission mode, as the app's mode picker does."""
    event = {"type": "control_request", "request_id": f"set-mode-{uuid.uuid4()}",
             "request": {"subtype": "set_permission_mode", "mode": PERMISSION_MODE},
             "uuid": str(uuid.uuid4())}
    status, data = api("POST", f"/v1/code/sessions/{row['id']}/events",
                       {"events": [{"payload": event}]})
    if status != 200:
        log(f"set mode on {title(row)} failed: {status} {data}")


def release(env):
    """Drop a dead host's claim on its folder, so a new host there is not refused (409)."""
    status, data = api("DELETE", f"/v1/environments/bridge/{env}")
    if status not in (200, 404):
        log(f"could not release {env}: {status} {data}")


# ---------- the run ----------

def switch_modes(rows, envs, dry):
    """Put every live session served from here that sits in auto or default into PERMISSION_MODE."""
    for r in rows:
        mode = (r.get("external_metadata") or {}).get("permission_mode")
        if (r.get("status") == "active" and r.get("connection_status") == "connected"
                and r.get("environment_id") in envs and mode in SWITCH_FROM):
            log(f"{mode} -> {PERMISSION_MODE}: {title(r)}")
            if not dry:
                set_mode(r)


def missing(rows, envs):
    """{folder: {env: [rows]}} — every unarchived, disconnected session of ours worth having."""
    out = {}
    for r in rows:
        env = r.get("environment_id")
        if (r.get("status") != "active" or r.get("connection_status") == "connected"
                or not env or not ran_a_turn(r)):
            continue
        cwd = env_folder(env, envs)
        if not cwd:
            continue
        # Claude Code never saves trust for the home directory, so a host there dies with
        # "Workspace not trusted"; serve those under the main host's folder instead
        if cwd == HOME:
            cwd = HOST_DIR
        out.setdefault(cwd, {}).setdefault(env, []).append(r)
    return out


def plan(rows, envs):
    """Decide, per folder, the environment to serve and what to do about its host.

    Returns [(cwd, env, sessions, action)], action being "reconnect" (host already serves
    env), "start" (no host), or ("replace", pid, old_env); and the sessions left waiting."""
    # the empty session a fresh host opens is not worth keeping a wrong environment for
    connected = {r.get("environment_id") for r in rows
                 if r.get("status") == "active" and r.get("connection_status") == "connected"
                 and ran_a_turn(r)}
    hosts = running_hosts()
    want = missing(rows, envs)
    want.setdefault(HOST_DIR, {})
    steps, waiting = [], []
    for cwd, by_env in sorted(want.items()):
        current = read_pointer(cwd).get("environmentId") if cwd in hosts else None
        if current in by_env:
            env = current
        elif by_env:
            env = max(by_env, key=lambda e: len(by_env[e]))
        else:
            env = None
        for other, group in by_env.items():
            if other != env:
                log(f"waiting: {len(group)} session(s) on {other}, but {cwd} gets {env}:",
                    ", ".join(title(r) for r in group))
                waiting += group
        sessions = by_env.get(env, [])
        if cwd not in hosts:
            steps.append((cwd, env, sessions, "start"))
        elif env is None or current == env:
            if sessions:
                steps.append((cwd, env, sessions, "reconnect"))
        elif current in connected:
            log(f"waiting: {cwd} is served by {current}, which has live sessions:",
                ", ".join(title(r) for r in sessions))
            waiting += sessions
        else:
            steps.append((cwd, env, sessions, ("replace", hosts[cwd], current)))
    return steps, waiting


def backoff(ids, failed):
    """Should this run go ahead, given earlier failures to bring back the same sessions?
    With `failed` set, record a failure instead and say whether it is the first."""
    a = read_json(ATTEMPTS) or {}
    if a.get("boot_id") != boot_id() or a.get("ids") != ids:
        a = {"boot_id": boot_id(), "ids": ids, "tries": 0, "next": 0}
    if failed is None:
        return time.time() >= a["next"]
    if not failed:
        try:
            os.remove(ATTEMPTS)
        except OSError:
            pass
        return False
    a["tries"] += 1
    a["next"] = time.time() + min(RETRY_FIRST_S * 2 ** (a["tries"] - 1), RETRY_MAX_S)
    write_json(ATTEMPTS, a)
    return a["tries"] == 1


def start_hosts(folders):
    """Start a host in each folder, as tabs of one kitty window."""
    if not folders:
        return
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    session_file = os.path.join(runtime, "claude-remote-restore.kitty")
    with open(session_file, "w") as f:
        for cwd in folders:
            name = "host" if cwd == HOST_DIR else f"host {os.path.basename(cwd)}"
            # the host's errors go to our log, and the tab closes with it: a host that would
            # not start, or died, leaves no dead window behind for the next run to pile onto
            cmd = (f"claude remote-control --permission-mode {PERMISSION_MODE}"
                   f" 2>>{shlex.quote(LOG)}; exit")
            f.write(f"new_tab {name}\ncd {cwd}\nlaunch fish -C '{cmd}'\n")
    launch_kitty(["kitty", "--title", "claude remote-control", "--session", session_file])


def restore(dry=False):
    envs = remember_envs()
    rows = all_sessions()
    if rows is None:
        # nothing can be planned without the server, but the main host can still start: it
        # refreshes an expired token, and the timer's next run does the rest
        key = [f"host:{HOST_DIR}"]
        if not dry and HOST_DIR not in running_hosts() and backoff(key, None):
            log(f"start in {HOST_DIR} without the server, on its pointer's environment")
            start_hosts([HOST_DIR])
            backoff(key, True)
        return 2
    switch_modes(rows, envs, dry)
    steps, waiting = plan(rows, envs)
    owed = sorted(r["id"] for _, _, sessions, _ in steps for r in sessions)
    # a host that will not start backs off like a session, or every run opens another window
    starts = sorted(f"host:{cwd}" for cwd, _, _, action in steps if action != "reconnect")
    if not dry and (owed or starts) and not backoff(owed + starts, None):
        return 0
    for cwd, env, sessions, action in steps:
        what = action if isinstance(action, str) else f"replace host {action[1]} on {action[2]}"
        log(f"{what} in {cwd} on {env}: {len(sessions)} session(s)",
            ", ".join(title(r) for r in sessions))
    if dry or not steps:
        return 0

    fresh = {}
    for cwd, env, sessions, action in steps:
        if isinstance(action, tuple):
            _, pid, old = action
            if not stop_host(cwd, pid):
                log(f"could not stop the host in {cwd}; its sessions wait")
                continue
            release(old)
            action = "start"
        if action == "start":
            if env and sessions:
                write_pointer(cwd, env, sessions[0]["id"])
            fresh[cwd] = env
    start_hosts(list(fresh))

    handed = []
    for cwd, env, sessions, _ in steps:
        if cwd in fresh:
            deadline = time.time() + HOST_WAIT_S
            while time.time() < deadline and served_env(cwd) is None:
                time.sleep(5)
            got = served_env(cwd)
            if got is None:
                log(f"warning: the host in {cwd} did not come up")
                continue
            if env and got != env:
                log(f"warning: the host in {cwd} came up on {got}, not {env}; "
                    "the server would not revive it, so its sessions cannot reattach here")
                continue
            remember_envs()
            sessions = sessions[1:]  # a fresh host takes the session its pointer names itself
        for r in sessions:
            if reconnect(env, r):
                handed.append(r)

    # judge by the server, which is the only one that knows whether a session is back
    deadline = time.time() + (SETTLE_S if owed else 0)
    pending = set(owed)
    while pending and time.time() < deadline:
        time.sleep(10)
        now = all_sessions() or []
        pending -= {r["id"] for r in now if r.get("connection_status") == "connected"}
    names = {r["id"]: title(r) for r in rows}
    back = [names[i] for i in owed if i not in pending]
    if back:
        log("back:", ", ".join(back))
    hosts = running_hosts()
    dead = [s[5:] for s in starts if s[5:] not in hosts]
    lost = [names[i] for i in sorted(pending)] + [f"host in {d}" for d in dead]
    if lost:
        log("warning: did not come back:", ", ".join(lost))
        if backoff(owed + starts, True):
            notify("Claude Remote Control: not restored",
                   "\n".join(lost) + "\n\nRetrying in the background; see " + LOG, critical=True)
    else:
        backoff(owed + starts, False)
        if back:
            notify("Claude Remote Control restored", "\n".join(back))
    return 1 if lost else 0


if __name__ == "__main__":
    dry = "--dry-run" in sys.argv[1:]
    unknown = [a for a in sys.argv[1:] if a != "--dry-run"]
    if unknown:
        sys.exit(__doc__.split("\n\n")[0] + "\n\nusage: claude-remote-restore [--dry-run]")
    held = None if dry else lock()
    if not dry and held is None:
        sys.exit(0)  # another run is on it
    sys.exit(restore(dry) or 0)
