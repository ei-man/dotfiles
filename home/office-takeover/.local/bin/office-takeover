#!/usr/bin/env python3
"""Office speakers: "last one wins" between this PC and AirPlay senders.

- The PC's default output is switched TO "Office" (low-latency RTP sink to the NUC):
  stop whatever AirPlay sender is playing on the NUC's shairport-sync. Music Assistant
  is stopped through its API; any other sender by restarting the receiver container.
- shairport-sync starts playing (its hook appends "play_begins" to events.log on the NUC):
  if the PC is on "Office", switch the PC back to the output it used before.
"""
import json
import pathlib
import subprocess
import threading
import time
import urllib.request

OFFICE = "office"
FALLBACK = "alsa_output.usb-SteelSeries_Arctis_Nova_Pro_Wireless-00.iec958-stereo"
STATE = pathlib.Path.home() / ".local/state/office-takeover/previous-sink"
MA_ENV = pathlib.Path.home() / ".config/music-assistant/token.env"
MA_PLAYERS = ("upf4fae190", "apb6fcb9e13e13")  # Office: universal + AirPlay player
EVENTS = "~/Projects/smart-home/shairport-sync/events/events.log"
SSH = ["ssh", "-o", "BatchMode=yes", "-o", "ServerAliveInterval=10",
       "-o", "ServerAliveCountMax=3", "nuc"]
PLAYER_STATE = ("docker exec shairport-sync dbus-send --system --print-reply "
                "--dest=org.gnome.ShairportSync /org/gnome/ShairportSync "
                "org.freedesktop.DBus.Properties.Get "
                "string:org.gnome.ShairportSync.RemoteControl string:PlayerState")


def log(msg):
    print(msg, flush=True)


def pactl(*args):
    return subprocess.run(["pactl", *args], capture_output=True, text=True).stdout


def default_sink():
    return pactl("get-default-sink").strip()


def sinks():
    return [l.split("\t")[1] for l in pactl("list", "sinks", "short").splitlines() if "\t" in l]


def save_previous(sink):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(sink)


def previous_sink():
    sink = STATE.read_text().strip() if STATE.exists() else ""
    return sink if sink in sinks() else FALLBACK


def ma_call(command, **args):
    env = {}
    for line in MA_ENV.read_text().splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            key, value = line.split("=", 1)
            env[key.removeprefix("export ").strip()] = value.strip().strip("'\"")
    req = urllib.request.Request(
        env["MA_URL"] + "/api",
        data=json.dumps({"command": command, "args": args, "message_id": 1}).encode(),
        headers={"Content-Type": "application/json", "Authorization": "Bearer " + env["MA_TOKEN"]})
    return json.load(urllib.request.urlopen(req, timeout=10))


def receiver_playing():
    out = subprocess.run(SSH + [PLAYER_STATE], capture_output=True, text=True, timeout=20).stdout
    return '"Playing"' in out


def claim_office():
    """The PC was switched to Office: stop the AirPlay sender, if there is one."""
    try:
        if not receiver_playing():
            return
        for player_id in MA_PLAYERS:
            try:
                ma_call("players/cmd/stop", player_id=player_id)
            except Exception as e:
                log(f"Music Assistant stop {player_id} failed: {e}")
        time.sleep(2)
        if receiver_playing():
            log("receiver still playing (not Music Assistant): restarting shairport-sync")
            subprocess.run(SSH + ["docker restart shairport-sync"], capture_output=True, timeout=60)
        else:
            log("stopped Music Assistant on Office")
    except Exception as e:
        log(f"claim failed: {e}")


def release_office():
    """Another sender started on Office: move the PC back to its previous output."""
    target = previous_sink()
    log(f"AirPlay started on Office: switching PC to {target}")
    pactl("set-default-sink", target)
    # Streams pinned to Office (moved there by hand) don't follow the default; move them too.
    office = next((l.split("\t")[0] for l in pactl("list", "sinks", "short").splitlines()
                   if l.split("\t")[1:2] == [OFFICE]), None)
    for line in pactl("list", "sink-inputs", "short").splitlines():
        fields = line.split("\t")
        if office and len(fields) > 1 and fields[1] == office:
            pactl("move-sink-input", fields[0], target)


def watch_pc():
    current = default_sink()
    if current and current != OFFICE:
        save_previous(current)
    while True:
        proc = subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE, text=True)
        for line in proc.stdout:
            if "'change' on server" not in line:
                continue
            new = default_sink()
            if new == current or not new:
                continue
            if new == OFFICE:
                log(f"PC switched to Office (from {current})")
                threading.Thread(target=claim_office, daemon=True).start()
            else:
                save_previous(new)
            current = new
        proc.wait()
        time.sleep(2)  # pipewire-pulse restarted; resubscribe


def watch_receiver():
    while True:
        proc = subprocess.Popen(SSH + [f"tail -n0 -F {EVENTS}"], stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, text=True)
        for line in proc.stdout:
            if line.split()[-1:] == ["play_begins"] and default_sink() == OFFICE:
                release_office()
        proc.wait()
        log("lost the ssh event stream from the NUC; reconnecting")
        time.sleep(5)


if __name__ == "__main__":
    threading.Thread(target=watch_receiver, daemon=True).start()
    watch_pc()
